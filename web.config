<configuration>
    <system.web>
	<httpRuntime maxRequestLength="25600" />
        <customErrors mode="Off" />
		  <compilation debug="true" />
		  <identity impersonate="false" />
      
      
    </system.web>
    <system.webServer>
        <defaultDocument>
            <files>
                <add value="default.aspx" />
            </files>
        </defaultDocument>
    </system.webServer>
</configuration>
