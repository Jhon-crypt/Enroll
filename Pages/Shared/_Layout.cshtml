<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>SATC Enrollment</title>
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="-1" />
    <meta http-equiv="CACHE-CONTROL" content="NO-CACHE" />
    <link rel="stylesheet" href="@Url.Content("~/css/site.css")" />
    <script>window.enrollBase = "@Url.Content("~/")";</script>
    <script src="@Url.Content("~/js/jquery-1.9.1.min.js")"></script>
</head>
<body>
    <table class="rounded" border="0" cellpadding="0" cellspacing="0" style="background-color:#002a64;" width="99%">
        <tr>
            <td bgcolor="#ffffff" valign="top" style="padding:25px;"><img alt="Logo" src="@Url.Content("~/images/logo.png")" /></td>
            <td bgcolor="#ffffff" style="width:100%;text-align:center;font-family:verdana; font-size:24pt; color:#17286d; font-weight:bold; padding:25px;" valign="top">Spring HS Course Enrollment Request</td>
        </tr>
        <tr>
            <td bgcolor="white" colspan="2">
                @RenderBody()
            </td>
        </tr>
    </table>
    <center>
        <font face="arial, verdana, sans" color="#000000" size="1">
            Copyright © @DateTime.Now.Year SATC&nbsp;
        </font>
    </center>
</body>
</html>
